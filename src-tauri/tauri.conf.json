{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TextForge",
  "version": "0.1.0",
  "identifier": "com.can5.textforge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TextForge",
        "width": 1180,
        "height": 760,
        "minWidth": 640,
        "minHeight": 420,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "TextForge",
    "longDescription": "Offline text and developer utilities (JSON, Markdown, Base64, hash, regex, diff and more)"
  }
}
